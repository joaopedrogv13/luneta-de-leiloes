{
  "name": "luneta-de-leiloes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:publicacao": "node scripts/checar-publicacao.mjs",
    "base:migrar": "node --experimental-strip-types --disable-warning=ExperimentalWarning base/cli.ts migrar",
    "base:coletar": "node --experimental-strip-types --disable-warning=ExperimentalWarning base/cli.ts coletar",
    "base:riscos": "node --experimental-strip-types --disable-warning=ExperimentalWarning base/cli.ts riscos",
    "base:exportar": "node --experimental-strip-types --disable-warning=ExperimentalWarning base/cli.ts exportar",
    "base:status": "node --experimental-strip-types --disable-warning=ExperimentalWarning base/cli.ts status",
    "base:fichas": "node --experimental-strip-types --disable-warning=ExperimentalWarning base/fontes/caixa/aplicar-fichas.ts",
    "base:geocode": "node --experimental-strip-types --disable-warning=ExperimentalWarning base/fontes/localizacao/aplicar.ts",
    "base:testar": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"base/**/*.test.ts\"",
    "leiloeiros:validar": "node --experimental-strip-types --disable-warning=ExperimentalWarning base/leiloeiros/validar.ts",
    "leiloeiros:relatorio": "node --experimental-strip-types --disable-warning=ExperimentalWarning base/leiloeiros/relatorio.ts",
    "coleta:pc": "node base/coleta-pc.mjs",
    "coleta:pc:fichas": "node base/coleta-pc.mjs --etapas fichas",
    "coleta:pc:bh": "node base/coleta-pc.mjs --etapas bh",
    "coleta:pc:publicar": "node base/coleta-pc.mjs --so-publicar",
    "test:site": "node --import jiti/register --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "gsap": "^3.15.0",
    "maplibre-gl": "^6.15.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jiti": "^2.7.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
